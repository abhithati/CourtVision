# Copy to `.env` and fill in as phases require. `.env` is gitignored.

# --- Phase 2+: database ---
# Start with SQLite (no setup), switch to PostgreSQL later.
DATABASE_URL=sqlite:///data/courtvision.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/courtvision

# --- Phase 3: experiment tracking ---
# MLFLOW_TRACKING_URI=./mlruns

# --- nba_api tuning (optional) ---
# stats.nba.com rate-limits aggressively; bump this if you hit timeouts.
NBA_API_REQUEST_TIMEOUT=30

data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Trained model artifacts
models/*
!models/.gitkeep

# Experiment tracking
mlruns/
wandb/

# Notebooks — strip checkpoints
.ipynb_checkpoints/

